{
  "name": "marcelle-platform",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @marcelle/database generate",
    "db:migrate": "pnpm --filter @marcelle/database migrate",
    "db:seed": "pnpm --filter @marcelle/database seed",
    "db:studio": "pnpm --filter @marcelle/database studio",
    "db:reset": "pnpm --filter @marcelle/database reset"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": ["eslint --fix", "prettier --write"],
    "*.{json,md,yml,yaml}": ["prettier --write"]
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
